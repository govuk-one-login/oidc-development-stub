{
  "name": "oidc-development-stub",
  "description": "OIDC provider and consumer stubs for local development and testing",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start:express": "npx tsx --env-file=.env src/server.ts",
    "start:express:watch": "npx tsx watch --include './src/*' --env-file=.env src/server.ts",
    "start:sam:local": "sam local start-api --template build/oidc-stub/template.yaml --env-vars parameters.json -p 3002",
    "build:lambda": "sam build --template template.yaml --build-dir build/oidc-stub",
    "build": "npx tsc",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "lint:fix": "eslint . && prettier --write .",
    "lint:check": "eslint . && prettier . --check",
    "localstack:up": "docker compose -f docker-compose.yaml up -d",
    "localstack:down": "docker compose -f docker-compose.yaml down"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1140.0",
    "@aws-sdk/client-secrets-manager": "^3.1140.0",
    "@aws-sdk/lib-dynamodb": "^3.1140.0",
    "@codegenie/serverless-express": "^5.0.0",
    "@koa/router": "^15.7.0",
    "express": "^5.2.1",
    "govuk-frontend": "^6.5.1",
    "jose": "^6.2.12",
    "nunjucks": "^3.2.4",
    "oidc-provider": "^9.12.2"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.163",
    "@types/express": "^5.0.6",
    "@types/koa-mount": "^4.0.5",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^26.6.2",
    "@types/nunjucks": "^3.2.6",
    "@types/oidc-provider": "^9.12.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-vitest": "^8.0.0",
    "eslint": "^10.11.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "prettier-plugin-jinja-template": "^2.2.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
